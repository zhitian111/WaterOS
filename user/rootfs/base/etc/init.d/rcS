#!/bin/sh
# WaterOS userspace-init 的 sysinit 脚本：由 /sbin/init（busybox）经
# /etc/inittab 的 ::sysinit 调用；内核已挂载 /proc 与 devfs。
export PATH=/bin:/sbin:/usr/bin:/usr/sbin:/opt/wateros/bin
[ -d /run ] || mkdir -p /run
[ -d /var/log ] || mkdir -p /var/log
echo "[rcS] WaterOS sysinit complete" > /dev/console
exit 0
