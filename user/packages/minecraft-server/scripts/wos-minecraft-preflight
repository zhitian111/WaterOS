#!/bin/sh
set -eu

JAVA=/usr/lib/jvm/java-21-openjdk/bin/java
SERVER_JAR=/opt/minecraft/server.jar
WORK=/tmp/wateros-minecraft-preflight
LOG=$WORK/server.log
PID=
VM_ARGS="-XX:+UseSerialGC -XX:ActiveProcessorCount=2 -XX:-UseCompressedOops -XX:-UseCompressedClassPointers -Xms64m -Xmx256m"
case "$(uname -m)" in
    riscv64|riscv*) VM_ARGS="-XX:TieredStopAtLevel=1 $VM_ARGS" ;;
esac

cleanup() {
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        kill "$PID" 2>/dev/null || true
        wait "$PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

rm -rf "$WORK"
mkdir -p "$WORK"
cd "$WORK"

"$JAVA" $VM_ARGS -jar "$SERVER_JAR" nogui >"$LOG" 2>&1 &
PID=$!
remaining=900
elapsed=0
echo "Minecraft preflight started; waiting up to 900 seconds for the EULA check ..."
while kill -0 "$PID" 2>/dev/null; do
    if [ "$remaining" -le 0 ]; then
        cat "$LOG"
        echo "Minecraft preflight timed out after 900 seconds." >&2
        exit 1
    fi
    sleep 1
    remaining=$((remaining - 1))
    elapsed=$((elapsed + 1))
    if [ $((elapsed % 30)) -eq 0 ]; then
        last_line=$(tail -n 1 "$LOG" 2>/dev/null || true)
        if [ -n "$last_line" ]; then
            echo "Minecraft preflight still running (${elapsed}s/900s): $last_line"
        else
            echo "Minecraft preflight still running (${elapsed}s/900s): waiting for Java output"
        fi
    fi
done

set +e
wait "$PID"
status=$?
set -e
PID=
cat "$LOG"

if [ "$status" -ne 0 ]; then
    echo "Minecraft preflight returned status $status" >&2
    exit 1
fi
grep -F 'Starting net.minecraft.server.Main' "$LOG" >/dev/null
grep -F 'You need to agree to the EULA' "$LOG" >/dev/null
grep -qx 'eula=false' "$WORK/eula.txt"
test -s "$WORK/versions/1.21.11/server-1.21.11.jar"
test -d "$WORK/libraries"
echo WATEROS_MINECRAFT_PREFLIGHT_OK
