#!/bin/sh
# Install Arch Linux RISC-V packages into a root isolated from WaterOS musl.
set -eu

root=${WATER_ARCHRISCV_ROOT:-/opt/archriscv}
dbpath="$root/var/lib/pacman"
cachedir="$root/var/cache/pacman/pkg"
mkdir -p "$dbpath/local" "$dbpath/sync" "$cachedir"

exec /usr/bin/pacman --root "$root" --dbpath "$dbpath" --cachedir "$cachedir" "$@"
