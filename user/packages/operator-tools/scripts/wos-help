#!/bin/sh
cat <<'EOF'
WaterOS operator commands:
  wos-info       show kernel, mount and memory information
  wos-syscall-smoke  verify transfer, ioprio, timerfd, recvmmsg and signalfd syscalls
  ps             list processes
  ip addr        show network addresses
  dmesg          show the kernel log when supported
  poweroff       request shutdown when supported
EOF
