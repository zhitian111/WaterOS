flowchart TB

  subgraph components["组件依赖｜实线箭头指向被调用组件"]
    direction TB

  subgraph entry["内核编排与用户接口层｜接收用户请求并组织内核启动"]
    direction LR
    wateros["wateros<br/>（内核入口与组件编排）"]
    syscall["wateros-syscall<br/>（系统调用分发）"]
  end

  subgraph core["内核核心服务层｜管理进程、内存与内核资源"]
    direction LR
    task["wateros-task<br/>（任务与调度）"]
    mm["wateros-mm<br/>（内存管理）"]
    vfs["wateros-vfs<br/>（虚拟文件系统）"]
    ipc["wateros-ipc<br/>（进程间通信）"]
    cred["wateros-cred<br/>（进程凭证）"]
    network["wateros-network<br/>（网络协议栈）"]
  end

  subgraph io["文件与设备服务层｜连接内核资源与外部设备"]
    direction LR
    fs["wateros-fs<br/>（文件系统）"]
    tty["wateros-tty<br/>（终端设备）"]
    gui["wateros-gui<br/>（图形与输入）"]
    driver["wateros-driver<br/>（设备驱动）"]
  end

  subgraph foundation["平台与基础设施层｜提供跨架构运行基础"]
    direction LR
    runtime["wateros-runtime<br/>（内核运行时）"]
    klog["wateros-klog<br/>（内核日志）"]
    platform["wateros-platform<br/>（架构、平台、IRQ）"]
    base["wateros-base<br/>（基础类型与配置）"]
    utils["wateros-utils<br/>（通用工具）"]
  end

  wateros --> syscall
  wateros --> runtime
  wateros --> utils

  syscall --> task
  syscall --> mm
  syscall --> vfs
  syscall --> ipc
  syscall --> cred
  syscall --> network

  vfs --> fs
  vfs --> tty
  gui --> driver
  network --> vfs
  cred --> task
  fs --> driver
  network --> driver
  driver --> platform
  runtime --> platform
  klog --> task
  klog --> platform
  task --> base
  mm --> base
  driver --> base

  task ~~~ mm ~~~ vfs ~~~ ipc ~~~ cred ~~~ network
  fs ~~~ tty ~~~ gui ~~~ driver
  runtime ~~~ klog ~~~ platform ~~~ base ~~~ utils

  class wateros boundary;
  class syscall configuration;
  class task,mm,vfs,ipc,cred,network service;
  class fs,tty,gui,driver interface;
  class runtime,klog,platform,base,utils foundation;


  end

  %% Runtime IRQ flow is separate from the component dependency arrows above.
  subgraph irq_path["外部 IRQ 运行链路｜设备中断固定路由至 BSP"]
    direction LR
    irq_controller["platform::irq<br/>RV PLIC / LA PCH PIC + EXTIOI"]
    irq_dispatch["wateros trap / device_irq<br/>有界 claim 与分发"]
    irq_ack["driver::irq<br/>无锁确认共享线路设备<br/>发布原子事件"]
    irq_complete["device_irq<br/>控制器 complete<br/>通知等待队列"]
    irq_worker["网络 / 控制台工作任务<br/>唤醒后处理设备数据"]
    irq_controller -->|外部 trap| irq_dispatch
    irq_dispatch --> irq_ack
    irq_ack --> irq_complete
    irq_complete -->|延后唤醒| irq_worker
  end
  components ~~~ irq_path
  class irq_controller foundation;
  class irq_dispatch,irq_complete boundary;
  class irq_ack interface;
  class irq_worker service;
