    "primaryTextColor": "#64172B",
    "secondaryTextColor": "#64172B",
    "tertiaryTextColor": "#64172B",
    "clusterBkg": "#FFF7F8",
    "clusterBorder": "#EFACB8",
    "edgeLabelBackground": "#FFF7F8"
  }
}
