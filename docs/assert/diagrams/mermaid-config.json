  "fontFamily": "Inter, Noto Sans SC, Source Han Sans SC, Arial, sans-serif",
  "flowchart": {
    "curve": "basis",
    "htmlLabels": true,
    "nodeSpacing": 28,
    "rankSpacing": 38,
    "padding": 14,
    "useMaxWidth": true
  },
  "themeVariables": {
    "background": "transparent",
    "fontSize": "16px",
